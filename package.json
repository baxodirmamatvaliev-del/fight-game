{
  "name": "neon-clash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 serve.py",
    "build": "node scripts/build.mjs",
    "test": "python3 -m unittest discover -s tests -v",
    "test:browser": "node tests/browser.mjs",
    "package": "node scripts/package.mjs",
    "test:practice": "node tests/practice-browser.mjs",
    "test:fallback": "node tests/fallback.mjs",
    "test:redesign": "node tests/redesign-browser.mjs",
    "test:landscape": "node tests/landscape-browser.mjs",
    "format": "prettier --write . && node scripts/format-python.mjs",
    "format:check": "prettier --check . && node scripts/format-python.mjs --check",
    "check": "npm run format:check && npm test && npm run test:fallback && npm run build"
  },
  "dependencies": {
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.8.1"
  }
}
